// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ─── Models ──────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // bcrypt-hashed
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Projects this user created (Admin only)
  createdProjects Project[] @relation("ProjectCreator")

  // Projects this user is a member of
  projects Project[] @relation("ProjectMembers")

  // Tasks assigned to this user
  tasks Task[] @relation("TaskAssignee")

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The admin who created this project
  createdById String
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)

  // Members assigned to this project (many-to-many implicit)
  members User[] @relation("ProjectMembers")

  // Tasks in this project
  tasks Task[]

  @@map("projects")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The project this task belongs to
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The user this task is assigned to
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}
